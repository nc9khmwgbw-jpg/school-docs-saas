{
    "name": "saas/school-docs-platform",
    "type": "project",
    "description": "Plateforme SaaS Universelle de Génération de Documents Scolaires Asynchrone",
    "keywords": [
        "saas",
        "multi-tenant",
        "documents",
        "pdf",
        "ecoles",
        "laravel"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.2|^8.3",
        "chillerlan/php-qrcode": "^6.0",
        "dompdf/dompdf": "^3.0",
        "enshrined/svg-sanitize": "^1.0",
        "ezyang/htmlpurifier": "^4.17",
        "laravel/framework": "^11.0|^12.0",
        "meyfa/php-svg": "^0.11",
        "phpoffice/phpspreadsheet": "^2.1",
        "predis/predis": "^3.7",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

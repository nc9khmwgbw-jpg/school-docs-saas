# ==============================================================================
# CONFIGURATION DE PRODUCTION — DocScolaire SaaS
# ==============================================================================
# Copiez ce fichier vers .env sur votre serveur VPS :
#   cp .env.production.example .env
# Puis renseignez vos clés secrètes et votre nom de domaine.
# ==============================================================================

APP_NAME="DocScolaire SaaS"
APP_ENV=production
APP_KEY=base64:GÉNÉREZ_AVEC_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://scolarite.votre-domaine.com
APP_TIMEZONE=Africa/Casablanca
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

# Journalisation sécurisée (Rotation quotidienne)
LOG_CHANNEL=daily
LOG_LEVEL=info

# Base de Données MySQL (Interne Docker - Pas d'accès externe)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=saas_documents
DB_USERNAME=saas_user
DB_PASSWORD=MOT_DE_PASSE_MYSQL_TRÈS_SÉCURISÉ_ICI
DB_ROOT_PASSWORD=MOT_DE_PASSE_ROOT_MYSQL_TRÈS_SÉCURISÉ_ICI

# Sessions et Cache ultra-performants via Redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=redis
CACHE_PREFIX=docscolaire_prod_

# Redis interne (Protégé dans le réseau Docker)
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=predis

# Traitement Asynchrone des Générations PDF (Worker Redis)
QUEUE_CONNECTION=redis

# Stockage des fichiers & documents générés
FILESYSTEM_DISK=local

# Configuration Email Réelle (SMTP de production : Brevo, Resend, Mailgun, OVH, Google)
MAIL_MAILER=smtp
MAIL_HOST=smtp.brevo.com
MAIL_PORT=587
MAIL_USERNAME=votre-compte-smtp@brevo.com
MAIL_PASSWORD=votre-cle-api-smtp-secrete
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@votre-domaine.com
MAIL_FROM_NAME="Service Scolarité — DocScolaire"

# Sécurité & Durcissement
BACKUP_OFFSITE_DIR=
